# BENCH ONLY overlay on defconfig.esp32ethernetbrick (Bluetooth enabled).
# Match WARP4's split-image layout, but NEVER enable secure boot/encryption.
CONFIG_PARTITION_TABLE_OFFSET=0xe000
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# WARP4 layout has no NVS partition: follow secure WARP4's PHY storage policy.
# CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE is not set
# Preserve BTC/BTU stacks and GATT/security settings. No mesh/provisioning action
# exists in this Ethernet/Tesla bench: remove only its unused internal pools.
CONFIG_BT_BTC_TASK_STACK_SIZE=8192
CONFIG_BT_BTU_TASK_STACK_SIZE=8192
# CONFIG_BLE_MESH is not set
# CONFIG_BTDM_BLE_MESH_SCAN_DUPL_EN is not set
# No NVS partition in WARP4: do not request persistent SMP bond storage.
# Tesla's application-key storage/authorization is unchanged.
# CONFIG_BT_BLE_SMP_BOND_NVS_FLASH is not set
# BENCH ONLY: preserve internal byte-accessible memory for controller/RTOS.
# Prefer existing PSRAM for ordinary malloc/realloc, including small host pools.
# Explicit INTERNAL|8BIT/DMA allocations and all task stacks stay internal.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
